# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# CORS: the origins allowed to call the API. Include every public hostname
# you route through cloudflared, plus localhost for local dev.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://dann.yourdomain.com"]

# Cloudflare Access defense-in-depth JWT check (see README "Local AI
# Workstation" section). Only needed once you're exposing the API beyond
# localhost via cloudflared + Access.
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
