# Ignore local virtual env
.venv/

# Local secrets / environment overrides
.env

# Personal runtime config (contains API keys / access keys) — copy from
# config.example.yaml instead. Previously tracked; a leaked Picovoice
# AccessKey in this file's git history is why it's ignored now.
config.yaml

# Cloudflare tunnel credentials (per-machine, generated by `cloudflared tunnel login`)
deploy/cloudflared/*.json
deploy/cloudflared/config.yml

# Ignore wake-word model binaries
models/*.tflite
models/*.onnx
models/*.bin
models/*.npz

# Python artifacts
__pycache__/
*.pyc
*.pyo

# UI
ui/node_modules/
ui/dist/
